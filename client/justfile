default:
    @just --list

# Run the Tauri app (spawns Vite via tauri.conf.json beforeDevCommand)
dev:
    bun run tauri dev

# Production build
build:
    bun run tauri build

# Install JS deps
install:
    bun install

# Build the desktop bundle + the release `stage` CLI, and link the CLI onto
# PATH so `stage open` can launch the app (ADR-0014). The release CLI's sibling
# `target/release/stage-client` is the local launch target; set STAGE_GUI_BIN
# to point at an installed bundle instead.
install-cli:
    bun run tauri build --bundles app
    cargo build -p stage-cli --release
    mkdir -p ~/.local/bin
    ln -sf "$(pwd)/target/release/stage" ~/.local/bin/stage

# Lint: Biome (TS) + cargo fmt --check (whole cargo workspace)
lint:
    bun run lint
    cargo fmt --all -- --check

# Clippy (heavier; not on pre-commit, runs via root `just verify` + CI)
clippy:
    cargo clippy --workspace --all-targets -- -D warnings

# Format: Biome (TS) + cargo fmt (whole cargo workspace)
fmt:
    bun run format
    cargo fmt --all

# Typecheck (TS) + cargo check (whole cargo workspace)
check:
    bun run typecheck
    cargo check --workspace --all-targets

# Tests
test:
    cargo test --workspace
